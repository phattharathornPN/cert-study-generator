#!/usr/bin/env bash
# Thin wrapper around the generation scripts so you don't retype the
# venv + NOTEBOOK_ID prefix every time. Run `./ccnp` for usage.
#
# NOTEBOOK_ID resolution order: existing env var -> .env file.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

# --- environment -----------------------------------------------------------
# Pick an interpreter that actually has notebooklm importable. The repo is
# shared between a Linux box (.venv, POSIX layout) and Windows/Git Bash, where
# .venv/bin/python is an unusable ELF binary -- sourcing activate there
# silently leaves `python` pointing at a system Python without the deps.
# So probe candidates instead of trusting activate.
PY=""
for cand in \
  ".venv/bin/python" \
  ".venv/Scripts/python.exe" \
  "${APPDATA:-}/uv/tools/notebooklm-py/Scripts/python.exe" \
  "$HOME/AppData/Roaming/uv/tools/notebooklm-py/Scripts/python.exe" \
  "$HOME/.local/share/uv/tools/notebooklm-py/bin/python" \
  "python3" "python"
do
  if command -v "$cand" >/dev/null 2>&1 || [[ -x "$cand" ]]; then
    if "$cand" -c "import notebooklm" >/dev/null 2>&1; then PY="$cand"; break; fi
  fi
done

if [[ -z "$PY" ]]; then
  echo "ERROR: no Python with notebooklm installed was found. Create one with:" >&2
  echo "  uv venv .venv && uv pip install --python .venv 'notebooklm-py[browser]'" >&2
  echo "or install it as a tool:  uv tool install 'notebooklm-py[browser]'" >&2
  exit 1
fi

# `notebooklm` as a bare command is unusable on Windows (Smart App Control
# blocks the unsigned shim), so always go through the module.
nlm() { "$PY" -m notebooklm "$@"; }

# Which exam this invocation drives. The sibling wrappers (./ccna, ./ccnp1,
# ./sec) set this explicitly; a bare ./ccnp now means the v2 CCNP pack, since
# that is the one being generated. The original 136-topic pack is still there
# as ./ccnp1 (CERT=ccnp).
export CERT="${CERT:-ccnp_v2}"

# Each cert declares its own notebook env var (NOTEBOOK_ID, NOTEBOOK_ID_CCNA,
# ...) in certs/<cert>.py, so ask the config rather than assuming.
NB_ENV="$("$PY" -c 'import cert_config; print(cert_config.NOTEBOOK_ENV)' 2>/dev/null)"
if [[ -z "$NB_ENV" ]]; then
  echo "ERROR: could not load config for CERT=$CERT" >&2
  "$PY" -c 'import cert_config' >&2
  exit 1
fi

if [[ -z "${!NB_ENV:-}" && -f .env ]]; then
  # shellcheck disable=SC1091
  set -a; source .env; set +a
fi

if [[ -z "${!NB_ENV:-}" ]]; then
  echo "ERROR: $NB_ENV not set (needed for CERT=$CERT). Either export it, or add it to .env:" >&2
  echo "  echo '$NB_ENV=your-notebook-id' >> .env" >&2
  exit 1
fi
export "${NB_ENV?}"
export NOTEBOOKLM_NOTEBOOK="${!NB_ENV}"   # the notebooklm CLI reads this one

LOG_DIR="logs"
mkdir -p "$LOG_DIR"
stamp() { date +%Y%m%d_%H%M%S; }

# Long runs go through `python -u` so `tee` shows progress live instead of
# sitting on a block-buffered pipe for minutes at a time.
run_logged() {
  local name="$1"; shift
  local log="$LOG_DIR/${name}_$(stamp).log"
  echo "-> logging to $log"
  "$PY" -u "$@" 2>&1 | tee "$log"
}

# Run a generation script, restarting it wherever it stopped.
#
# The in-process auth keepalive cannot actually save a long run: it refreshes
# storage_state.json from a subprocess, but the live NotebookLMClient keeps its
# credentials in memory and never re-reads that file, so the token still ages
# out mid-run. Restarting the process is what genuinely picks up a fresh token,
# and the scripts already print the exact id to resume from.
run_resuming() {
  local name="$1" script="$2" start="${3:-}" prof="${4:-}"
  local log="$LOG_DIR/${name}_$(stamp).log"
  local attempt=0 last_start="" repeats=0 next
  local extra=()
  [[ -n "$start" ]] && extra+=(--start-id "$start")
  [[ -n "$prof" ]] && extra+=(--profile "$prof")

  echo "-> logging to $log"
  while :; do
    attempt=$((attempt + 1))
    echo ""
    echo "===== attempt $attempt${start:+ (from $start)}${prof:+ (profile $prof)} ====="
    "$PY" -u "$script" "${extra[@]}" 2>&1 | tee -a "$log"

    if tail -n 5 "$log" | grep -q 'complete!'; then
      echo ""
      echo "===== finished after $attempt attempt(s) ====="
      break
    fi

    next="$(grep -o -- '--start-id [0-9][0-9]_[0-9][0-9]' "$log" | tail -n 1 | awk '{print $2}')"
    if [[ -z "$next" ]]; then
      echo ""
      echo "===== stopped with no resume point -- check $log ====="
      break
    fi

    if [[ "$next" == "$last_start" ]]; then
      repeats=$((repeats + 1))
    else
      repeats=0
    fi
    if (( repeats >= 2 )); then
      echo ""
      echo "===== $next failed 3 times running -- giving up, check $log ====="
      break
    fi
    last_start="$next"
    start="$next"

    echo ""
    echo "===== stopped at $next -- refreshing auth and resuming ====="
    if ! nlm auth refresh; then
      echo "===== auth refresh failed -- run: ./ccnp auth login ====="
      break
    fi
    sleep 5
  done
}

# --- commands --------------------------------------------------------------
cmd="${1:-help}"; shift || true

case "$cmd" in
  summary)
    # ./ccnp summary [start-id]      -- auto-resumes past token expiry
    run_resuming summary summary_only.py "${1:-}"
    ;;

  slides)
    # ./ccnp slides [profiles]   -- one cycle of slides_v2.py
    #
    # slides_v2 keeps its own ledger, lock and retry policy, so there is
    # nothing for the shell to supervise: no resume loop, no profile
    # bookkeeping. Normally the slides-cycle@ timer runs this; the command is
    # here for running a cycle by hand.
    profs="${1:-default,account2,account3,account4,account5}"
    log="$LOG_DIR/slides_$(stamp).log"
    echo "-> logging to $log"
    "$PY" -u slides_v2.py --profiles "$profs" 2>&1 | tee -a "$log"
    ;;

  slides-fast)
    echo "slides-fast has been removed -- it had no ledger, no lock and a flat" >&2
    echo "retry, and lost requested decks. Use:  ./ccnp slides" >&2
    exit 1
    ;;

  summary-fast)
    # ./ccnp summary-fast [workers] [profile] -- either order, both optional.
    # Anything numeric is the worker count, anything else is a profile name,
    # so `./ccnp summary-fast acct3` does the obvious thing instead of trying
    # to run "acct3" workers. Summaries are chat calls, not artifacts, and do
    # not hit the artifact allowance that makes slides slow.
    script="summary_parallel.py"; workers=4; label="summaries"
    prof=""
    for a in "$@"; do
      if [[ "$a" =~ ^[0-9]+$ ]]; then workers="$a"; else prof="$a"; fi
    done

    prof_args=(); refresh_args=()
    if [[ -n "$prof" ]]; then
      # Check the auth files directly. Grepping `notebooklm profile list`
      # means parsing a rich-rendered table whose padding and width shift
      # with the terminal, which produced false "does not exist" errors.
      IFS=',' read -r -a prof_list <<< "$prof"
      for p in "${prof_list[@]}"; do
        auth_file="$HOME/.notebooklm/profiles/$p/storage_state.json"
        if [[ ! -s "$auth_file" ]]; then
          if [[ -d "$HOME/.notebooklm/profiles/$p" ]]; then
            echo "ERROR: profile '$p' exists but is not authenticated." >&2
          else
            echo "ERROR: profile '$p' does not exist." >&2
          fi
          echo "  Log in with:  ./deploy/desktop_login.sh $p" >&2
          echo "" >&2
          nlm profile list >&2
          exit 1
        fi
      done

      # summary_parallel.py drives one account at a time.
      prof_args=(--profile "${prof_list[0]}")
      refresh_args=(-p "${prof_list[0]}")
    fi

    # Count finished artifacts of this kind. Comparing the count across a pass
    # is what separates "the daily quota is spent, wait it out" from "still
    # producing, go again now" -- the rate-limit error text alone cannot.
    export CCNP_COUNT_FILE="summary_th.md"
    done_count() {
      "$PY" - <<'PY'
import os
from cert_config import OUTPUT_DIR, SLIDE_FORMATS, TOPICS
from run import topic_to_slug

name = os.environ["CCNP_COUNT_FILE"]
if name == "slide":
    name = f"slide.{SLIDE_FORMATS[0]}"
n = 0
for t in TOPICS:
    p = os.path.join(OUTPUT_DIR, f"{t['id']}_{topic_to_slug(t['topic'])}", name)
    if os.path.exists(p) and os.path.getsize(p) > 0:
        n += 1
print(n)
PY
    }

    log="$LOG_DIR/${cmd//-/_}_$(stamp).log"
    echo "-> logging to $log"
    attempt=0
    idle=0
    # Passes of zero progress before stopping; each idle pass waits 15-30 min,
    # so 48 is roughly a day. Set IDLE_GIVE_UP=0 on a box that stays up to
    # keep waiting forever -- the point of leaving it running is to be awake
    # whenever the quota window happens to refill.
    IDLE_GIVE_UP="${IDLE_GIVE_UP:-48}"
    while :; do
      attempt=$((attempt + 1))
      before="$(done_count)"
      echo ""
      echo "===== pass $attempt (${workers} workers${prof:+, profile $prof}) -- ${before} done ====="
      "$PY" -u "$script" --workers "$workers" "${prof_args[@]}" 2>&1 | tee -a "$log"
      after="$(done_count)"

      if tail -n 5 "$log" | grep -qE 'Nothing to do|0 still pending'; then
        echo ""
        echo "===== all ${label} complete ====="
        break
      fi
      # A Python traceback means the script itself is broken (bad argument,
      # missing file). Retrying that just reprints the same crash forever.
      if tail -n 20 "$log" | grep -q '^Traceback (most recent call last)'; then
        echo ""
        echo "===== crashed -- not a quota problem, see the traceback above ====="
        break
      fi

      if (( after > before )); then
        idle=0
        wait_s=60
        echo "===== +$((after - before)) this pass, ${after} done -- continuing ====="
      else
        # Nothing came out, so the daily quota is spent. Quota windows refill
        # over hours; retrying in seconds just burns requests against a wall.
        idle=$((idle + 1))
        if (( idle < 3 )); then wait_s=900; else wait_s=1800; fi
        echo "===== no progress (idle x${idle}) -- quota looks spent, waiting $((wait_s / 60)) min ====="
        if (( IDLE_GIVE_UP > 0 && idle >= IDLE_GIVE_UP )); then
          echo "===== ${IDLE_GIVE_UP} idle passes with no progress -- stopping, check $log ====="
          break
        fi
      fi

      # Refresh every account in play, not just the first: with several
      # driving one notebook, one expired session must not end the run while
      # the others are still good.
      refreshed=0
      if [[ -n "$prof" ]]; then
        for p in "${prof_list[@]}"; do
          nlm -p "$p" auth refresh >/dev/null 2>&1 && refreshed=$((refreshed + 1))
        done
      else
        nlm auth refresh >/dev/null 2>&1 && refreshed=1
      fi
      if (( refreshed == 0 )); then
        echo "no account could refresh its session -- sign in again:"
        echo "    ./deploy/desktop_login.sh ${prof_list[0]:-default}"
        break
      fi
      sleep "$wait_s"
    done
    ;;

  summary-once)
    # single pass, no auto-resume (for debugging)
    script="summary_only.py"
    if [[ $# -gt 0 ]]; then
      run_logged "${cmd}" "$script" --start-id "$1"
    else
      run_logged "${cmd}" "$script"
    fi
    ;;

  topic)
    # ./ccnp topic 01_23 [--summary-only]
    if [[ $# -eq 0 ]]; then
      echo "usage: ./ccnp topic <id> [--summary-only]" >&2; exit 1
    fi
    run_logged "topic_$1" rerun_topic.py "$@"
    ;;

  status)
    "$PY" - <<'PY'
import os
from cert_config import OUTPUT_DIR, SLIDE_FORMATS, TOPICS
from run import topic_to_slug

# Only count the slide formats this cert actually downloads, otherwise a
# pdf-only cert would always look permanently half-finished.
FILES = ("summary_th.md", *(f"slide.{f}" for f in SLIDE_FORMATS),
         "audio.mp3", "flashcards.json")
counts = dict.fromkeys(FILES, 0)
incomplete = []

for t in TOPICS:
    folder = os.path.join(OUTPUT_DIR, f"{t['id']}_{topic_to_slug(t['topic'])}")
    missing = []
    for f in FILES:
        p = os.path.join(folder, f)
        if os.path.exists(p) and os.path.getsize(p) > 0:
            counts[f] += 1
        else:
            missing.append(f)
    if missing:
        incomplete.append((t["id"], t["topic"], missing))

total = len(TOPICS)
print(f"Topics: {total}\n")
for f in FILES:
    n = counts[f]
    bar = "#" * int(28 * n / total)
    print(f"  {f:<16} {n:>3}/{total}  {bar}")

pending = [x for x in incomplete if "summary_th.md" in x[2]]
if pending:
    print(f"\nNo summary yet ({len(pending)}), next up: {pending[0][0]} {pending[0][1]}")
else:
    print("\nAll summaries present.")

no_slide = [x for x in incomplete if "slide.pdf" in x[2]]
if no_slide:
    print(f"No slide yet ({len(no_slide)}), first: {no_slide[0][0]} {no_slide[0][1]}")
PY
    ;;

  sources)
    "$PY" - <<'PY'
import asyncio, os
from notebooklm import NotebookLMClient

import cert_config
NB = cert_config.notebook_id()

async def main():
    async with NotebookLMClient.from_storage() as client:
        srcs = await client.sources.list(NB)
        derived = [s for s in srcs if s.title and s.title.startswith("[SRC ")]
        limit = await client.sources._get_source_limit()
        print(f"total           : {len(srcs)} / {limit}")
        print(f"[SRC] derived   : {len(derived)}   (own summaries, regenerated by slides run)")
        print(f"reference       : {len(srcs) - len(derived)}")

asyncio.run(main())
PY
    ;;

  clean-src)
    # ./ccnp clean-src [--yes]     (dry run without --yes)
    "$PY" -u clean_src_sources.py "$@"
    ;;

  auth)
    # ./ccnp auth [refresh|check|login|list] [profile] [browser]
    #   ./ccnp auth login                     -- default profile, chrome
    #   ./ccnp auth login account2            -- second account
    #   ./ccnp auth login account2 msedge     -- ...via Edge (SSO orgs need this)
    #   ./ccnp auth check account2
    #
    # Note the CLI wants the profile as a GLOBAL option before the
    # subcommand (`notebooklm -p acct login`), not `notebooklm login acct`.
    action="${1:-check}"
    aprof="${2:-}"
    abrowser="${3:-chrome}"
    pargs=()
    [[ -n "$aprof" ]] && pargs=(-p "$aprof")

    case "$action" in
      refresh) nlm "${pargs[@]}" auth refresh ;;
      login)   nlm "${pargs[@]}" login --browser "$abrowser" ;;
      list)    nlm profile list ;;

      # Pull cookies straight out of an already-signed-in browser instead of
      # driving a Playwright window. Much more reliable than `login` once the
      # persistent browser profile gets big -- that's what makes the login
      # window close on itself mid-flow.
      #   ./ccnp auth cookies                  -- every signed-in account -> its own profile
      #   ./ccnp auth cookies chrome           -- from Chrome instead of Edge
      cookies)
        nlm login --browser-cookies "${2:-edge}" --all-accounts
        ;;
      *)       nlm "${pargs[@]}" auth check --test --json ;;
    esac
    ;;

  doctor)
    # ./ccnp doctor -- which interpreter got picked and what it can import
    echo "PY        : $PY"
    "$PY" -c "import sys; print('resolved  :', sys.executable)"
    for m in notebooklm rookiepy google.genai; do
      if "$PY" -c "import $m" >/dev/null 2>&1; then
        echo "$m: OK"
      else
        echo "$m: MISSING"
      fi
    done
    echo "CERT: $CERT"
    echo "$NB_ENV: ${!NB_ENV:0:8}..."
    ;;

  watch)
    # Follow the active cert's directory, not a hardcoded output/ -- otherwise
    # a CERT=ccnp_v2 run looks permanently stuck at zero.
    outdir="$("$PY" -c 'import cert_config; print(cert_config.OUTPUT_DIR)')"
    watch -n 30 "ls $ROOT/$outdir/*/summary_th.md 2>/dev/null | wc -l; ls -t $ROOT/$outdir/ | head -3"
    ;;

  *)
    cat <<'USAGE'
ccnp -- CCNP ENCOR study-pack generator

Generation (long running; logs land in logs/):
  ./ccnp slides [profiles]        one slide cycle: request, collect, sweep
  ./ccnp summary-fast [workers]   summaries, N at a time (default 4)
  ./ccnp summary [start-id]       summaries, one at a time  (~3-4 h)

  Slides normally run themselves -- `systemctl enable --now
  slides-cycle@ccnp_v2.timer` fires a cycle every 20 minutes. Each cycle
  records every request in v2/ledger.json before making it, so a crash or a
  reboot costs one cycle, never a requested deck.
  ./ccnp topic <id> [--summary-only]
                                  redo ONE topic; old files move to _prev/

  Everything skips work that is already on disk, so re-running after any
  stop is safe -- no --start-id bookkeeping for slides. The sequential
  summary runner resumes by id instead:
      ./ccnp summary 03_05

Inspect:
  ./ccnp status                 per-artifact progress + what's next
  ./ccnp sources                notebook source counts vs limit
  ./ccnp watch                  live summary count, refreshes every 30s

Maintenance:
  ./ccnp clean-src              dry run: list derived [SRC] sources
  ./ccnp clean-src --yes        delete them (do this before a full rerun)
  ./ccnp auth [check|refresh|login] [profile] [browser]
                                e.g. ./ccnp auth login account2
                                     ./ccnp auth login account2 msedge
  ./ccnp auth cookies [browser] import EVERY signed-in Google account from
                                your real browser (edge by default) -- no
                                login window, survives a bloated profile
  ./ccnp auth list              show all profiles and which are logged in

Order for a full rebuild:
  1. mv output output_backup_$(date +%F) && mkdir output
  2. ./ccnp clean-src --yes
  3. ./ccnp summary
  4. ./ccnp slides
Never run 3 and 4 at the same time -- they share the rate limit.
USAGE
    ;;
esac
