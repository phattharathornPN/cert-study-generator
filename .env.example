# Copy this file to .env before running any script -- ./ccnp reads it
# automatically. Calling a python script directly (not through ./ccnp)
# instead needs these exported into the shell, since the scripts read real
# environment variables, not this file via a dotenv library.
#
# PowerShell:
#   $env:NOTEBOOK_ID_CCNP_V2 = "your-notebook-id-here"

# One NOTEBOOK_ID_<CERT> per cert you use, matching NOTEBOOK_ENV in that
# cert's certs/<cert>.py. Get the id from the notebook's URL:
# https://notebooklm.google.com/notebook/<THIS-PART-IS-YOUR-NOTEBOOK_ID>

NOTEBOOK_ID_CCNP_V2=
NOTEBOOK_ID_CCNA=
# NOTEBOOK_ID_SECURITY=
# NOTEBOOK_ID_<YOUR_NEW_CERT>=
