# Copy this file to .env (or set these as real environment variables) before
# running any script.
#
# PowerShell:
#   $env:NOTEBOOK_ID = "your-notebook-id-here"
#   $env:GEMINI_API_KEY = "your-gemini-key-here"   # optional, only for
#                                                    # generate_slide_instructions.py

# Get this from the NotebookLM notebook's URL:
# https://notebooklm.google.com/notebook/<THIS-PART-IS-YOUR-NOTEBOOK_ID>
NOTEBOOK_ID=

# Optional: only needed if you use generate_slide_instructions.py or
# gemini_slides.py. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
